# Copy to .env.local and fill in when real services are wired up.
# Nothing here is required yet — the app runs on in-memory stubs by default.

# --- Admin panel (/admin) ---
# Insecure "admin" default is used if unset — set this before deploying anywhere real.
ADMIN_PASSWORD=

# --- Database (once a real DB replaces the in-memory store) ---
DATABASE_URL=

# --- Wallet / anonymous session auth (once real Sign-In-with-Ethereum-style auth replaces the mock session) ---
AUTH_SESSION_SECRET=

# --- Crypto payments (real, Base mainnet — see README "Real payments") ---
# REQUIRED for payments to work at all. Generate/export this yourself and set
# it directly on your host (e.g. `railway variables --set`) — never commit it,
# never paste it into chat with an AI assistant. The wallet needs real ETH on
# Base (gas) and, to receive sales, real USDC.
TREASURY_PRIVATE_KEY=
# Optional overrides — sensible defaults are baked into src/lib/chain/index.ts
BASE_RPC_URL=
USDC_CONTRACT_ADDRESS=

# --- AI moderation ---
# Optional bootstrap value for the AI key — the admin panel (/admin/settings)
# can also set/replace this at runtime without an env var or restart.
MODERATION_API_KEY=
